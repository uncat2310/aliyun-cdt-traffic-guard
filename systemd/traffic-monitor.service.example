[Unit]
Description=Alibaba Cloud CDT Traffic Guard & Monitoring Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/traffic_guard/backend
ExecStart=/usr/bin/node /opt/traffic_guard/backend/src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
